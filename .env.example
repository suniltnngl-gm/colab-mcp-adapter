# Colab MCP Adapter — Environment Configuration
# Copy this file to .env and fill in the values.
# Do NOT commit .env (it contains machine-specific paths and secrets).

# Required: Path to the Colab CLI executable.
# Use an absolute path for relocation resilience.
# Example: COLAB_CLI_PATH=/usr/local/bin/colab
# Example: COLAB_CLI_PATH=C:\Program Files\Colab CLI\colab.exe
COLAB_CLI_PATH=colab

# Optional: Default timeout for Colab CLI commands in seconds (10-3600).
# COLAB_CLI_TIMEOUT_SECONDS=300

# Optional: Default session timeout in seconds (60-86400).
# DEFAULT_SESSION_TIMEOUT_SECONDS=1800

# Optional: Default maximum conversation turns per session (1-100).
# DEFAULT_MAX_TURNS=10

# Optional: Log level (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO

# Optional: Log output format (json, text).
# LOG_FORMAT=text

# Optional: Server host (for HTTP mode; stdio mode ignores this).
# SERVER_HOST=127.0.0.1

# Optional: Server port (for HTTP mode; stdio mode ignores this).
# SERVER_PORT=8000

# Optional: Comma-separated list of allowed CORS origins (for HTTP mode).
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional: Maximum concurrent sessions (1-1000).
# MAX_CONCURRENT_SESSIONS=100

# Optional: Maximum code execution time per request in seconds (10-3600).
# MAX_CODE_EXECUTION_TIME_SECONDS=600

# Optional: Default kernel type for new sessions.
# COLAB_DEFAULT_KERNEL=python3

# Optional: Automatically clean up completed sessions (true/false).
# COLAB_AUTO_CLEANUP=true